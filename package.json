{
  "name": "claude-command-cli",
  "version": "0.1.0",
  "description": "Termux CLI for Claude with Cloudflare Worker & NVIDIA Nemotron",
  "type": "module",
  "main": "warnetech_cli_legacy/warnetech",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler publish",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest --testPathPattern=integration",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rm -rf dist/ .wrangler/"
  },
  "keywords": [
    "cli",
    "termux",
    "cloudflare",
    "worker",
    "nvidia",
    "nemotron",
    "ai"
  ],
  "author": "Warnetech Team",
  "license": "MIT",
  "dependencies": {
    "crypto-js": "^4.1.5",
    "argon2-browser": "^1.3.0",
    "axios": "^1.6.0",
    "commander": "^11.0.0",
    "dotenv": "^16.3.1",
    "fs-extra": "^11.1.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240221.0",
    "eslint": "^8.50.0",
    "eslint-config-prettier": "^9.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.0.3",
    "wrangler": "^3.24.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
