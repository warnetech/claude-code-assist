// Fix command
program
  .command("fix <file>")
  .description("Fix code issues in a file")
  .option(
    "--apply",
    "Ask the AI for a unified diff and apply it with `git apply` (backs up the file to <file>.bak first)",
  )
  .action(async (file, options) => {
    try {
      const config = await loadConfig();
      if (!config.nemotron_api_key) {
        console.log("✗ Error: NVIDIA_API_KEY not found in config");
        console.log("  Run: warnetech init");
        process.exit(1);
      }

      console.log(`✓ Analyzing ${file}...`);

      let content;
      try {
        content = await fs.readFile(file, "utf-8");
      } catch (error) {
        console.log(`✗ Error: Could not read ${file}`);
        console.log(`  ${error.message}`);
        process.exit(1);
      }

      // System prompt per docs/07_AI_INTEGRATION.md's `warnetech fix` spec.
      const prompt = [
        `Analyze the following file (${file}) and:`,
        "1. Identify any bugs, issues, or potential problems",
        "2. Suggest specific fixes with code examples",
        "3. Explain why each fix is needed",
        "4. Rate severity: critical | high | medium | low",
        "",
        "Focus on: security vulnerabilities, performance issues, code quality, best practices.",
        "",
        `--- ${file} ---`,
        content,
      ].join("\n");

      const { ok, data, error } = await sendToWorker("ai", [prompt], config);
      if (!ok) {
        console.log("✗ Error: Failed to analyze file");
        console.log(`  ${error || data?.error}`);
        process.exit(1);
      }

      console.log("");
      console.log(data.data.response);
      console.log("");

      if (!options.apply) {
        console.log(
          `Run "warnetech fix ${file} --apply" to have the AI generate a patch and apply it (a .bak backup is made first).`,
        );
        return;
      }

      console.log("> Requesting a patch to apply...");
      const diffPrompt = `${prompt}\n\nRespond with ONLY a valid unified diff (git diff format, paths relative to the current directory) that applies your fix. No prose, no markdown code fences.`;
      const diffResult = await sendToWorker("ai", [diffPrompt], config);
      if (!diffResult.ok) {
        console.log("✗ Error: Could not generate a patch to apply");
        console.log(`  ${diffResult.error || diffResult.data?.error}`);
        process.exit(1);
      }

      // A trailing newline is required for `git apply` to accept a hunk
      // ending mid-file (its absence reads as "corrupt patch") — trim
      // stray whitespace from the model's response, then add exactly one
      // back.
      const patch = `${diffResult.data.data.response.trim()}\n`;
      const backupPath = `${file}.bak`;
      await fs.copyFile(file, backupPath);
      console.log(`✓ Backed up original to ${backupPath}`);

      const tmpPatchPath = path.join(
        os.tmpdir(),
        `warnetech-fix-${Date.now()}.patch`,
      );
      await fs.writeFile(tmpPatchPath, patch, "utf-8");

      try {
        await execAsync(`git apply "${tmpPatchPath}"`);
        console.log(`✓ Applied fix to ${file}`);
        console.log(`  Backup kept at: ${backupPath}`);
      } catch (applyError) {
        console.log("✗ Error: Failed to apply patch automatically");
        // execAsync's rejection carries git's actual error on stderr; the
        // top-level .message is just "Command failed: git apply ...".
        console.log(`  ${(applyError.stderr || applyError.message).trim().split("\n").pop()}`);
        console.log(`  Patch saved at: ${tmpPatchPath}`);
        console.log(`  Original is untouched; backup also at: ${backupPath}`);
        process.exit(1);
      }
    } catch (error) {
      console.log("✗ Error: Unexpected error");
      console.log(`  ${error.message}`);
      process.exit(1);
    }
  });

