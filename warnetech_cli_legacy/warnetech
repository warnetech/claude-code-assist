program
  .command("update")
  .description("Update CLI to latest version")
  .option("--check", "Only check for updates")
  .action(async (options) => {
    // There's no signed GitHub-releases / R2-backup pipeline in this repo
    // (see docs/05_CLI_COMMANDS.md's aspirational version of this command),
    // so "update" here means what CLAUDE.md's own git workflow already
    // relies on: fetch + fast-forward pull of the current branch.
    try {
      console.log(options.check ? "✓ Checking for updates..." : "✓ Updating CLI...");

      await execAsync("git fetch origin");
      const { stdout: branchOut } = await execAsync(
        "git rev-parse --abbrev-ref HEAD",
      );
      const branch = branchOut.trim();
      const { stdout: localOut } = await execAsync("git rev-parse HEAD");
      const { stdout: remoteOut } = await execAsync(
        `git rev-parse origin/${branch}`,
      );
      const local = localOut.trim();
      const remote = remoteOut.trim();

      if (local === remote) {
        console.log(`✓ Already up to date (${branch} @ ${local.slice(0, 7)})`);
        return;
      }

      const { stdout: countOut } = await execAsync(
        `git rev-list --count ${local}..${remote}`,
      );
      console.log(
        `✓ Update available: ${countOut.trim()} commit(s) behind origin/${branch}`,
      );

      if (options.check) {
        console.log("  Run without --check to pull the latest changes");
        return;
      }

      console.log("> Pulling...");
      await execAsync("git pull --ff-only");
      const newPkg = JSON.parse(
        await fs.readFile(path.join(__dirname, "../package.json"), "utf-8"),
      );
      console.log(`✓ Updated to ${newPkg.version} (${remote.slice(0, 7)})`);
    } catch (error) {
      console.log("✗ Error: Update failed");
      console.log(`  ${error.message.split("\n")[0]}`);
      console.log(
        "  This checks/pulls the current git branch — make sure the working tree is clean and origin is reachable.",
      );
      process.exit(1);
    }
  });

program
  .command("evolve")
  .description("Self-update with AI synthesis & verification")
  .option("--dry-run", "Simulate update without deploying")
  .option("--check", "Only check for updates")
  .action(async (options) => {
    // docs/09_AUTOMATION_PLAN.md describes a full sandbox-synthesis /
    // atomic-deploy / rollback pipeline (D1 patch queue, staging Worker
    // deploys, an AST mutation engine). None of that infrastructure
    // exists in this repo, and a CLI that unattendedly rewrites and
    // redeploys its own code is a real safety hazard — not something to
    // fake with console.log lines. This implements the one safe, real
    // slice of it: ask the AI for improvement suggestions grounded in
    // this repo's own outstanding TODOs, and leave review/apply/deploy
    // to a human (e.g. via `warnetech fix <file> --apply`).
    try {
      console.log("🔄 Starting evolution (synthesis-only; see comments in this file)...");
      const config = await loadConfig();

      let todoOutput = "";
      try {
        const { stdout } = await execAsync(
          'grep -rn "TODO" --include=*.js --include=*.py . 2>/dev/null | grep -v node_modules | head -40',
        );
        todoOutput = stdout;
      } catch (_error) {
        // grep exits non-zero when there are no matches — that's fine, not a failure.
        todoOutput = "";
      }

      if (options.check) {
        const todoCount = todoOutput.trim()
          ? todoOutput.trim().split("\n").length
          : 0;
        console.log(`✓ Found ${todoCount} outstanding TODO(s) in the working tree`);
        console.log("  Run without --check to get AI suggestions for them");
        return;
      }

      if (!config.nemotron_api_key) {
        console.log("✗ Error: NVIDIA_API_KEY not found in config");
        console.log("  Run: warnetech init");
        process.exit(1);
      }

      const prompt = [
        "Here are outstanding TODO comments from a codebase:",
        "",
        todoOutput || "(none found)",
        "",
        "Suggest concrete, minimal next steps to resolve the 3 most impactful ones.",
        "Do not invent files or APIs that aren't shown above.",
      ].join("\n");

      console.log("🔨 Synthesizing suggestions from AI...");
      const { ok, data, error } = await sendToWorker("ai", [prompt], config);
      if (!ok) {
        console.log("✗ Error: Could not get suggestions");
        console.log(`  ${error || data?.error}`);
        process.exit(1);
      }

      console.log("");
      console.log(data.data.response);
      console.log("");

      if (options.dryRun) {
        console.log("✓ Dry run complete — no files written, nothing deployed.");
        return;
      }

      console.log("✓ Suggestions generated. Stopping here on purpose:");
      console.log("  automated verification/deployment/rollback isn't implemented");
      console.log('  (see the comment above "warnetech evolve" for why) —');
      console.log("  review the suggestions and apply them by hand, e.g.:");
      console.log('  warnetech fix "<file>" --apply');
    } catch (error) {
      console.log("✗ Error: Unexpected error");
      console.log(`  ${error.message}`);
      process.exit(1);
    }
  });

