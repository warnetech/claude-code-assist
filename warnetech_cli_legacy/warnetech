  .description("Initialize configuration")
  .option("--force", "Overwrite an existing config file")
  .action(async (options) => {
    const configDir = path.join(os.homedir(), ".claude-cli");
    const configPath = path.join(configDir, "config.json");

    try {
      await fs.access(configPath);
      if (!options.force) {
        console.log(`✗ Config already exists: ${configPath}`);
        console.log("  Run: warnetech init --force to overwrite");
        process.exit(1);
      }
    } catch (_error) {
      // Doesn't exist yet — nothing to do, fall through to create it.
    }

    console.log("✓ Initializing configuration...");

    try {
      await fs.mkdir(configDir, { recursive: true });

      // Defaults per docs/05_CLI_COMMANDS.md's `warnetech init` spec.
      const defaultConfig = {
        api_key: "your-key-here",
        worker_url: "https://your-worker.workers.dev",
        nemotron_api_key: "your-nemotron-key",
        github_token: "your-github-token",
        tier: 2,
        cache_dir: path.join(configDir, "cache"),
      };

      // 0o600: this file holds secrets (api_key, tokens) — keep it
      // readable only by the owner, per CLAUDE.md's "never log/leak
      // plaintext secrets" principle. `mode` on writeFile only takes
      // effect when the file is newly created (POSIX open() semantics),
      // so with --force overwriting a pre-existing (possibly
      // loosely-permissioned) file we chmod explicitly afterwards too.
      await fs.writeFile(
        configPath,
        `${JSON.stringify(defaultConfig, null, 2)}\n`,
        { mode: 0o600 },
      );
      await fs.chmod(configPath, 0o600);

      console.log(`Created: ${configPath}`);
      console.log("  Edit it to set your real api_key, worker_url, and nemotron_api_key.");
    } catch (error) {
      console.log("✗ Error: Could not create config");
      console.log(`  ${error.message}`);
      process.exit(1);
    }
  });

program.parse();
