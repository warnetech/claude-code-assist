// Load config
async function loadConfig() {
  const configPath = path.join(os.homedir(), ".claude-cli", "config.json");
  try {
    const data = await fs.readFile(configPath, "utf-8");
    return JSON.parse(data);
  } catch (error) {
    return { worker_url: "http://localhost:8787", api_key: "dev-key" };
  }
}

// Send request to Worker
async function sendToWorker(command, args = [], config = null) {
  if (!config) config = await loadConfig();

  const workerUrl = config.worker_url || "http://localhost:8787";
  const apiKey = config.api_key || "dev-key";
  const requestId = generateRequestId();
  const timestamp = new Date().toISOString();

  const payload = {
    command,
    args,
  };

  try {
    // Encrypt payload
    const encryptedPayload = await encryptData(JSON.stringify(payload), apiKey);

    // Generate signature
    const signature = generateHmacSignature(
      { encrypted_data: encryptedPayload },
      apiKey,
    );

    const request = {
      encrypted_data: encryptedPayload,
      signature,
    };

    const response = await fetch(`${workerUrl}/cli`, {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        "X-API-Key-Hash": hashApiKey(apiKey),
        "X-Request-ID": requestId,
        "X-Timestamp": timestamp,
      },
      body: JSON.stringify(request),
    });

    const responseData = await response.json();

    // Decrypt response if encrypted
    if (responseData.encrypted_data && responseData.signature) {
      try {
        const decrypted = await decryptData(
          responseData.encrypted_data,
          apiKey,
        );
        return {
          ok: response.ok,
          status: response.status,
          data: JSON.parse(decrypted),
        };
      } catch (error) {
        return {
          ok: false,
          error: `Failed to decrypt response: ${error.message}`,
        };
      }
    }

    return { ok: response.ok, status: response.status, data: responseData };
  } catch (error) {
    return { ok: false, error: error.message };
  }
}

// Ping command - Test connectivity with Worker
program
  .command("ping")
  .description("Check connectivity with Worker")
  .action(async () => {
    try {
      const config = await loadConfig();
      console.log("> Checking Worker connectivity...");
      const { ok, data, error } = await sendToWorker("ping", [], config);

      if (!ok) {
        console.log("✗ Error: Failed to connect to Worker");
        console.log(`  Reason: ${error || data?.error}`);
        process.exit(1);
      }

      console.log("✓ Ping: Connected");
      console.log(`  Worker: ${config.worker_url}`);
      console.log(`  Message: ${data.data.message}`);
      console.log(
        `  Latency: ${Date.now() - new Date(data.timestamp).getTime()}ms`,
      );
    } catch (error) {
      console.log("✗ Error: Unexpected error");
      console.log(`  ${error.message}`);
      process.exit(1);
    }
  });

