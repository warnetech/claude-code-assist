# Credentials are resolved by the official SDKs in this order:
#   ANTHROPIC_API_KEY -> ANTHROPIC_AUTH_TOKEN -> `ant auth login` profile -> WIF
# You do not need this file at all if you have run `ant auth login`.
ANTHROPIC_API_KEY=

# Optional: where llmforge writes its JSONL trace stream.
LLMFORGE_TRACE=.llmforge/trace.jsonl

# Optional: default model override for examples and labs.
LLMFORGE_MODEL=claude-opus-5
