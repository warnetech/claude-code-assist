# Copy to .env (gitignored) and fill in what you use. Every entry is optional:
# the tests, examples and CI need none of them. Full list: docs/09-credentials.md

# --- Claude (llmforge + aicli) ------------------------------------------
# llmforge's SDK resolves: ANTHROPIC_API_KEY -> ANTHROPIC_AUTH_TOKEN ->
# `ant auth login` profile -> WIF. aicli reads ANTHROPIC_API_KEY only.
ANTHROPIC_API_KEY=
# ANTHROPIC_AUTH_TOKEN=

# --- Other model APIs (aicli) -------------------------------------------
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=

# --- Tooling -------------------------------------------------------------
# CODEFLASH_API_KEY=

# --- Non-secret settings -------------------------------------------------
# Where llmforge writes its JSONL trace stream.
LLMFORGE_TRACE=.llmforge/trace.jsonl
# Default model override for examples and labs.
LLMFORGE_MODEL=claude-opus-5
# aicli state directory (config, history, audit log).
# AICLI_HOME=~/.aicli
